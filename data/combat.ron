// Combat rules: placeholder values, to balance with mass simulations (`batch`), then
// recalibrate the statistical model (`calibrate`, `compare`).
(
    // Chance an attack hits: even_percent × 2 × accuracy / (accuracy + target's speed),
    // in percent, kept between min_percent and max_percent. The standard duel's fighters
    // have accuracy 30 against speed 30, so they hit at even_percent.
    accuracy: (
        even_percent: 85,
        min_percent: 25,
        max_percent: 95,
    ),
    // A hit that neither kills nor makes its target give up may stun it: a chance in
    // hundredths of a percent per tenth of the target's max HP the hit takes, by the
    // spell's damage kind (Cutting a third of Blunt, Neutral never), raised by
    // head_injury_percent of it per head injury.
    // A stunned fighter stays down for `ticks` (30 per second), its opponent waiting,
    // then gets up with a chance from its boldness, lower for each stun after the
    // first; if it does not, it is knocked out and loses, alive.
    stun: (
        blunt_hundredths: 500,
        cutting_hundredths: 167,
        head_injury_percent: 50,
        ticks: 60,
        rise_percent_most_timid: 30,
        rise_percent_boldest: 90,
        rise_percent_lost_per_stun: 20,
    ),
    // A cutting hit that lands may sever the part it lands on: the head, killing, with
    // head_hundredths per tenth of the target's max HP the hit takes, or with
    // fatal_head_percent on a hit that brings it to 0 HP (no surviving that fatal blow);
    // a limb, if the target still fights, with limb_hundredths per tenth: out of the
    // fight alive, with a permanent injury there; the body, never.
    cut: (
        limb_hundredths: 75,
        head_hundredths: 17,
        fatal_head_percent: 100,
    ),
    // Where a hit lands, by relative chances; the side of an arm or leg is drawn 50/50.
    // The model draws a lost limb's arm or leg by these weights too.
    hits: (head: 3, body: 3, arm: 2, leg: 2),
    // A spell's bleed_percent (data/classes.ron) is its chance to make the part it lands
    // on bleed, if that part does not already: it then takes hp_percent_per_second of
    // the fighter's max HP (at least 1) each second, for its part's seconds. Bleedings
    // of different parts add up; a bleeding may kill or make give up.
    bleed: (
        hp_percent_per_second: 1,
        head_seconds: 4,
        body_seconds: 6,
        arm_seconds: 5,
        leg_seconds: 5,
    ),
    // A mine spell (mine: true in data/classes.ron) lays a mine at its target's feet,
    // seen by everyone. Armed after arm_ticks (30 per second), it blasts under whoever
    // touches it (radius, in meters), its layer too, hitting everyone within
    // blast_radius with the spell's power and damage kind, never missed; gone after
    // life_ticks. Past max_per_fighter, a fighter's oldest mine is gone. Provisional.
    // A fighter giving up runs for the arena's door (see arenas) at this percentage of
    // its speed, hit until through it.
    flee_speed_percent: 300,
    mines: (
        arm_ticks: 45,
        life_ticks: 900,
        radius: 0.3,
        blast_radius: 1.5,
        max_per_fighter: 4,
    ),
    // Each weapon type's auto attack, a spell outside the class's three, cheap: a fighter
    // strikes with it only once none of its spells is both affordable and of use there
    // (a mine with the target too close, nothing to gather, a shot blocked), so it always
    // has a little attack left. The weapon types wait for balancing.
    weapons: {
        "glaive": (
            name: "Estoc",
            range: Melee,
            reach: 1.0,
            power: 40,
            cooldown: 45,
            cost: (endurance: 1),
            damage_kind: Cutting,
        ),
        "sword": (
            name: "Taille d'épée",
            range: Melee,
            reach: 1.0,
            power: 40,
            cooldown: 45,
            cost: (endurance: 1),
            damage_kind: Cutting,
        ),
        "rune-dagger": (
            name: "Coup de dague",
            range: Melee,
            reach: 1.0,
            power: 30,
            cooldown: 30,
            cost: (endurance: 1),
            damage_kind: Cutting,
        ),
        "staff": (
            name: "Revers de bâton",
            range: Melee,
            reach: 1.0,
            power: 30,
            cooldown: 45,
            cost: (endurance: 1),
            damage_kind: Blunt,
        ),
        "bow": (
            name: "Tir simple",
            range: Ranged,
            reach: 8.0,
            power: 50,
            cooldown: 45,
            cost: (endurance: 1),
            damage_kind: Cutting,
            accuracy_percent: 70,
        ),
    },
    // Each colosseum's arena kind (data/world.ron) sets its floor: a size in meters,
    // the percentage of their speed fighters walk at, and round pillars (center and
    // radius in meters) that block the way and ranged spells, at least a fighter's
    // width from the walls. A duel starts at 15 % and 85 % of the width, mid-height.
    arenas: (
        // Deep sand slows everyone: ranged fighters shoot longer before melee closes in.
        // A fighter giving up must run out through the door, on a wall, to be out.
        sand: (
            width: 20.0,
            height: 20.0,
            speed_percent: 70,
            pillars: [],
            door: (x: 10.0, y: 0.0),
        ),
        // A row of pillars across the middle hides the fighters from each other's shots.
        pillars: (
            width: 20.0,
            height: 20.0,
            speed_percent: 100,
            pillars: [
                (x: 10.0, y: 4.0, radius: 1.2),
                (x: 10.0, y: 10.0, radius: 1.2),
                (x: 10.0, y: 16.0, radius: 1.2),
            ],
            door: (x: 10.0, y: 0.0),
        ),
        // A small floor: melee fighters reach their opponent fast.
        narrow: (
            width: 8.0,
            height: 6.0,
            speed_percent: 100,
            pillars: [],
            door: (x: 4.0, y: 0.0),
        ),
    ),
    // The melee, or King of the hill: everyone at once in the colosseum's arena, grown
    // so that each fighter has square_meters_per_fighter, starting on a circle, for at
    // most max_ticks (30 per second).
    melee: (
        max_fighters: 20,
        square_meters_per_fighter: 30.0,
        max_ticks: 5400,
        // Only the first paid_places bring money and fame, the last one standing all of
        // the colosseum's melee_prize and fame's melee_survival, each place below a
        // share less, the last paid one a share; the loading checks that its share of
        // the prize pays every colosseum's entry fee, the journey apart.
        paid_places: 12,
        // Two standing fighters without an ally, within `distance` meters between their
        // edges, make a pact at each decision (5 per second) with a chance from the
        // boldness of the bolder (from 0 to 100); allies do not aim at each other.
        // A pact is betrayed at each decision with a chance from the boldness of the
        // bolder, and every pact breaks once break_fighting or fewer are left.
        pacts: (
            distance: 3.0,
            form_percent_most_timid: 10,
            form_percent_boldest: 0,
            betrayal_percent_boldest: 2,
            break_fighting: 3,
        ),
        // Every every_ticks (15 s), the next number of out who dealt the least damage
        // since the last check are out, a defeat alive (equal damage: the one with less
        // HP left), never leaving fewer than final_fighters, who fight the final: from
        // 20, 3, 3, 4, 2, 2, 2 and 2 out, then a duel.
        elimination: (every_ticks: 450, out: [3, 3, 4, 2, 2, 2, 2], final_fighters: 2),
    ),
)
