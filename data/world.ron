// The world's colosseums: placeholder values, to tune while balancing.
(
    // Elo of a fighter's first fight in a colosseum, and how far one fight moves it.
    elo_start: 1000,
    elo_k: 32,
    // Residents' stats grow by this percentage for each prestige level above 1.
    prestige_stats_percent: 10,
    // A champion must defend the title at least once in this many weeks, against a
    // challenger from the first `challengers` of the ranking.
    title_defense_weeks: 4,
    challengers: 5,
    // The rival managers' weekly thresholds, by profile. A fighter rests below
    // `rest_form` or when badly hurt or ill, cared for if the club keeps `care_reserve`
    // after paying; fit, it fights in the colosseum where Elo gives it the best chances
    // against the others, if at least `fight_percent`, else trains. The club accepts the
    // player's challenges when Elo gives it `accept_percent` chances.
    // On the market, it asks `sell_percent` of a fighter's value and offers `buy_percent`
    // for the player's listed fighters, if it keeps `care_reserve` and has a place, and
    // `unsolicited_percent` of that price for one not for sale, the more it gambles. Its
    // trainer, then its doctor (a poor club's recruiter first), are the best whose salaries it could
    // pay `staff_weeks` weeks from its money, kept while it could pay half as many
    // (data/economy.ron). What lowers its relation with the player's club weighs
    // `anger_percent`, a deal concluded with it `deal_percent` (`relations`). It rates
    // the fighters it signs, buys and lets go by `recruits`: by value if left out,
    // `Youth` its value times `percent` up to `until` years old, `Grown` from `from`
    // years old, `Crowd` its fame alone, whatever its stats.
    profiles: (
        cautious: (rest_form: 70, care_reserve: 0, fight_percent: 45, accept_percent: 50, sell_percent: 150, buy_percent: 60, unsolicited_percent: 130, staff_weeks: 20, anger_percent: 100, deal_percent: 100),
        // Quick to take offence.
        aggressive: (rest_form: 35, care_reserve: 100, fight_percent: 20, accept_percent: 20, sell_percent: 130, buy_percent: 80, unsolicited_percent: 160, staff_weeks: 10, anger_percent: 150, deal_percent: 100),
        // Keeps its money, sells cheap and buys dear; forgives when the price is right.
        merchant: (rest_form: 50, care_reserve: 300, fight_percent: 35, accept_percent: 35, sell_percent: 100, buy_percent: 90, unsolicited_percent: 120, staff_weeks: 40, anger_percent: 100, deal_percent: 300),
        // Raises young fighters, while they still progress fast (data/fighter.ron).
        mentor: (rest_form: 60, care_reserve: 50, fight_percent: 40, accept_percent: 45, sell_percent: 140, buy_percent: 70, unsolicited_percent: 140, staff_weeks: 30, anger_percent: 100, deal_percent: 100, recruits: Youth(until: 25, percent: 150)),
        // Wants fighters already grown, past their fast progression.
        veteran: (rest_form: 50, care_reserve: 100, fight_percent: 30, accept_percent: 30, sell_percent: 120, buy_percent: 85, unsolicited_percent: 140, staff_weeks: 20, anger_percent: 100, deal_percent: 100, recruits: Grown(from: 28, percent: 150)),
        // Wants who draws the crowd, whatever their stats.
        showman: (rest_form: 40, care_reserve: 50, fight_percent: 25, accept_percent: 25, sell_percent: 130, buy_percent: 75, unsolicited_percent: 150, staff_weeks: 15, anger_percent: 120, deal_percent: 100, recruits: Crowd),
    ),
    // Free agents choose their fights by this profile's thresholds, to show their worth,
    // as managers without money: only in colosseums free to enter, never trained nor
    // cared for. They earn Elo, a record and fame, but no money.
    free_agents: Aggressive,
    // A rival club below `wanted` fighters in activity signs free agents; at `max`, it
    // buys no one.
    roster: (wanted: 10, max: 12),
    // The rival clubs, drawn when the world opens: `count` of them (at least one), each
    // with a profile and a wealth drawn by these weights, (weight, value); each
    // continent has its share of them by its weight, and a club's culture is drawn by
    // weight among those of its continent (data/names.ron), which names it.
    // A club starts with its wealth's money (data/economy.ron) and the first residents
    // of its continent's colosseums, shared out among its clubs in turn, then
    // generated fighters up to `roster.wanted`. Wealth changes with money at each
    // off-season: a rich club buys at will and lets go whoever no longer performs, a
    // poor one hires a recruiter first and signs the free agents of the best potential
    // it sees. A poor club with less than `ruined_below` money at an off-season's
    // start is ruined; ruined `ruined_seasons` off-seasons in a row, it closes and its
    // fighters go to the market. Then as many clubs are founded as closed, at least
    // `founded`, never more than `max` open at once (performance: about 25 ms a week
    // at 160 clubs, 70 ms at 320).
    clubs: (
        count: 40,
        max: 100,
        founded: 1,
        ruined_below: 1750,
        ruined_seasons: 2,
        profiles: [(1, Cautious), (1, Aggressive), (1, Merchant), (1, Mentor), (1, Veteran), (1, Showman)],
        // Many poor, few rich.
        wealth: [(5, Poor), (3, Modest), (1, Rich)],
        continents: [(1, Europe), (1, Asia), (1, Americas), (1, Africa), (1, Oceania)],
        cultures: [
            (4, "rome"), (2, "grece"), (2, "celtes"), (2, "germains"),
            (2, "steppe"), (2, "asie_est"), (2, "inde"), (2, "asie_ouest"), (2, "arabe"),
            (2, "amerindiens"), (2, "mesoamerique"), (2, "amerique_sud"),
            (2, "afrique"),
            (2, "oceanie"),
        ],
    ),
    // Added to the entry fee of a colosseum on another continent than the club's: the
    // journey. A club fights at home, abroad only when no colosseum at home suits it.
    travel_fee: 40,
    // The world's news (titles changing hands, champions bought, clubs closed and
    // founded) are kept this many weeks.
    news_weeks: 30,
    // Each rival club's relation with the player's club, from -100 to +100, starting
    // at 0: the points of each event, weighed by the club's profile (`anger_percent`,
    // `deal_percent`), then coming back `decay` points towards 0 each week. A kill or
    // a win against one of its fighters, its title taken by the player's fighter,
    // a sale or a purchase between the two, a pact kept or
    // betrayed by the player's fighter in a melee. The last `history` changes are
    // kept for each club, with their reason.
    relations: (
        killed: -30,
        beaten: -5,
        title_taken: -10,
        deal: 5,
        pact_kept: 5,
        betrayed: -25,
        decay: 1,
        history: 20,
        // From the ally down, the standing of a score is the first whose `from` it
        // reaches. The club asks the player `price_percent` of its price and offers
        // its price divided by it; `deals: false` trades nothing; `challenge_points`
        // take from what its fighter needs to accept the player's challenges; `pact_points` add to the chance, in percent
        // at each decision of a melee, that its fighters ally with the player's (by
        // caution alone between fighters of other clubs or without a club).
        standings: (
            ally: (from: 60, deals: true, price_percent: 85, challenge_points: 0, pact_points: 10),
            friend: (from: 20, deals: true, price_percent: 95, challenge_points: 0, pact_points: 5),
            neutral: (from: -19, deals: true, price_percent: 100, challenge_points: 0, pact_points: 0),
            tense: (from: -59, deals: true, price_percent: 115, challenge_points: 10, pact_points: 0),
            rival: (from: -100, deals: false, price_percent: 100, challenge_points: 25, pact_points: -100),
        ),
        // A club whose score falls to a rival's declares itself the player's rival,
        // and stays so until its score climbs back to `ends_from`. A fight between
        // their fighters draws a crowd: `receipts_percent` of the receipts to both
        // clubs, and `fame` to both fighters, whatever the result.
        rivalry: (ends_from: -19, receipts_percent: 150, fame: 3),
    ),
    // Each fighter's tie with each club it was in, from -100 to +100, starting at 0:
    // `weekly` points each week in the club, `decay` back towards 0 each week for the
    // others; `released` when let go for nothing (released, or a contract not
    // renewed), `sold` when sold. Below `refuses_below` it refuses to sign with the
    // club; `refusal_percent` of its tie with the club it leaves, less its tie with
    // the one it would join, adds to the chance it refuses a move: loyal to its club,
    // glad to come back to one it liked.
    ties: (weekly: 1, decay: 1, released: -60, sold: -20, refuses_below: -30, refusal_percent: 50),
    // What the floors of each continent's colosseums offer a maître du terrain to
    // gather and throw (a spell's gathers and thrown, data/classes.ron): stone in Europe,
    // sand in Africa, obsidian in the Americas, kelp in Oceania, jade in Asia.
    elements: {Europe: Stone, Asia: Jade, Americas: Obsidian, Africa: Sand, Oceania: Kelp},
    // Each continent has a major colosseum, of the highest prestige, and one or two
    // minor ones around it, where prestige-2 ones ask a small fee; on each continent
    // where clubs live, at least one must be free to enter: the safety net of a club
    // without money. Capoue, in Europe, is where one starts by default.
    colosseums: [
        (
            key: "capoue",
            continent: Europe,
            // Its floor is in data/combat.ron (arenas): sand slows, pillars block shots
            // and the way, narrow is small, so melee closes in fast.
            arena: Sand,
            // 1 to 5.
            prestige: 1,
            // Rival fighters ranked here at the opening, as strong as its prestige,
            // shared out among the clubs of its continent.
            residents: 8,
            purses: (
                entry_fee: 0,
                win_prize: 50,
                // Paid win or lose: base + per_fame × (fame of both fighters).
                receipts_base: 20,
                receipts_per_fame: 1,
                // Paid for each title defense the club's champion survives.
                champion_bonus: 30,
                // The season-opening melee pays this to the club of the last one
                // standing and to each other's its place's share, down to nothing for
                // the first one out: the same for every fighter, whatever its fame.
                melee_prize: 150,
            ),
        ),
        (
            key: "rome",
            continent: Europe,
            arena: Pillars,
            prestige: 3,
            residents: 10,
            purses: (entry_fee: 20, win_prize: 150, receipts_base: 40, receipts_per_fame: 1, champion_bonus: 100, melee_prize: 450),
        ),
        (
            key: "pompei",
            continent: Europe,
            arena: Narrow,
            prestige: 2,
            residents: 8,
            purses: (entry_fee: 10, win_prize: 100, receipts_base: 30, receipts_per_fame: 1, champion_bonus: 60, melee_prize: 300),
        ),
        (
            key: "samarcande",
            continent: Asia,
            arena: Sand,
            prestige: 1,
            residents: 8,
            purses: (entry_fee: 0, win_prize: 50, receipts_base: 20, receipts_per_fame: 1, champion_bonus: 30, melee_prize: 150),
        ),
        (
            key: "chang_an",
            continent: Asia,
            arena: Narrow,
            prestige: 2,
            residents: 8,
            purses: (entry_fee: 10, win_prize: 100, receipts_base: 30, receipts_per_fame: 1, champion_bonus: 60, melee_prize: 300),
        ),
        (
            key: "karakorum",
            continent: Asia,
            arena: Pillars,
            prestige: 3,
            residents: 10,
            purses: (entry_fee: 20, win_prize: 150, receipts_base: 40, receipts_per_fame: 1, champion_bonus: 100, melee_prize: 450),
        ),
        (
            key: "cahokia",
            continent: Americas,
            arena: Sand,
            prestige: 1,
            residents: 8,
            purses: (entry_fee: 0, win_prize: 50, receipts_base: 20, receipts_per_fame: 1, champion_bonus: 30, melee_prize: 150),
        ),
        (
            key: "cuzco",
            continent: Americas,
            arena: Narrow,
            prestige: 2,
            residents: 8,
            purses: (entry_fee: 10, win_prize: 100, receipts_base: 30, receipts_per_fame: 1, champion_bonus: 60, melee_prize: 300),
        ),
        (
            key: "tenochtitlan",
            continent: Americas,
            arena: Pillars,
            prestige: 3,
            residents: 10,
            purses: (entry_fee: 20, win_prize: 150, receipts_base: 40, receipts_per_fame: 1, champion_bonus: 100, melee_prize: 450),
        ),
        (
            key: "mbanza_kongo",
            continent: Africa,
            arena: Sand,
            prestige: 1,
            residents: 8,
            purses: (entry_fee: 0, win_prize: 50, receipts_base: 20, receipts_per_fame: 1, champion_bonus: 30, melee_prize: 150),
        ),
        (
            key: "grand_zimbabwe",
            continent: Africa,
            arena: Sand,
            prestige: 1,
            residents: 8,
            purses: (entry_fee: 0, win_prize: 50, receipts_base: 20, receipts_per_fame: 1, champion_bonus: 30, melee_prize: 150),
        ),
        (
            key: "musumba",
            continent: Africa,
            arena: Pillars,
            prestige: 3,
            residents: 10,
            purses: (entry_fee: 20, win_prize: 150, receipts_base: 40, receipts_per_fame: 1, champion_bonus: 100, melee_prize: 450),
        ),
        (
            key: "nan_madol",
            continent: Oceania,
            arena: Sand,
            prestige: 1,
            residents: 8,
            purses: (entry_fee: 0, win_prize: 50, receipts_base: 20, receipts_per_fame: 1, champion_bonus: 30, melee_prize: 150),
        ),
        (
            key: "rapa_nui",
            continent: Oceania,
            arena: Sand,
            prestige: 1,
            residents: 8,
            purses: (entry_fee: 0, win_prize: 50, receipts_base: 20, receipts_per_fame: 1, champion_bonus: 30, melee_prize: 150),
        ),
        (
            key: "ngapuhi",
            continent: Oceania,
            arena: Pillars,
            prestige: 3,
            residents: 10,
            purses: (entry_fee: 20, win_prize: 150, receipts_base: 40, receipts_per_fame: 1, champion_bonus: 100, melee_prize: 450),
        ),
    ],
)
