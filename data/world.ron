// The world's colosseums: placeholder values, to tune while balancing.
(
    // Elo of a fighter's first fight in a colosseum, and how far one fight moves it.
    elo_start: 1000,
    elo_k: 32,
    // Residents' stats grow by this percentage for each prestige level above 1.
    prestige_stats_percent: 10,
    // A champion must defend the title at least once in this many weeks, against a
    // challenger from the first `challengers` of the ranking.
    title_defense_weeks: 4,
    challengers: 5,
    challenges: (
        // Lost by a fighter who refuses a challenge and does not fight that week; the
        // Elo in the challenger's colosseum.
        refusal_fame: 2,
        refusal_elo: 8,
    ),
    // The rival managers' weekly thresholds, by profile. A fighter rests below
    // `rest_form` or when badly hurt or ill, cared for if the club keeps `care_reserve`
    // after paying; fit, it fights in the colosseum where Elo gives it the best chances
    // against the others, if at least `fight_percent`, else trains. Each week, a club's
    // fighter ranked somewhere is challenged by the rival fighter closest in Elo with
    // `challenge_percent` chances; the
    // club accepts the player's challenges when Elo gives it `accept_percent` chances.
    // On the market, it asks `sell_percent` of a fighter's value and offers `buy_percent`
    // for the player's, if it keeps `care_reserve` and has a place. Its trainer, then
    // its doctor (a poor club's recruiter first), are the best whose salaries it could
    // pay `staff_weeks` weeks from its money, kept while it could pay half as many
    // (data/economy.ron).
    profiles: (
        cautious: (rest_form: 70, care_reserve: 0, fight_percent: 45, accept_percent: 50, challenge_percent: 10, sell_percent: 150, buy_percent: 60, staff_weeks: 20),
        aggressive: (rest_form: 35, care_reserve: 100, fight_percent: 20, accept_percent: 20, challenge_percent: 40, sell_percent: 130, buy_percent: 80, staff_weeks: 10),
        // Keeps its money, sells cheap and buys dear.
        merchant: (rest_form: 50, care_reserve: 300, fight_percent: 35, accept_percent: 35, challenge_percent: 20, sell_percent: 100, buy_percent: 90, staff_weeks: 40),
    ),
    // Free agents choose their fights by this profile's thresholds, to show their worth,
    // as managers without money: only in colosseums free to enter, never trained nor
    // cared for. They earn Elo, a record and fame, but no money.
    free_agents: Aggressive,
    // A rival club below `wanted` fighters in activity signs free agents; at `max`, it
    // buys no one.
    roster: (wanted: 10, max: 12),
    // The rival clubs, starting with their wealth's money (data/economy.ron) and the
    // colosseums' first residents, shared out among them in turn. At least one. Wealth
    // changes with money at each off-season: a rich club buys at will and lets go
    // whoever no longer performs, a poor one hires a recruiter first and signs the free
    // agents of the best potential it sees.
    rivals: [
        (name: "Ludus Magnus", profile: Cautious, wealth: Rich),
        (name: "Ludus Gallicus", profile: Aggressive, wealth: Poor),
        (name: "Ludus Dacicus", profile: Merchant, wealth: Modest),
    ],
    // At least one must be free to enter: the safety net of a club without money.
    colosseums: [
        (
            name: "Capoue",
            // Effects come with phase 6: sand slows, pillars block shots, narrow favours melee.
            arena: Sand,
            // 1 to 5.
            prestige: 1,
            // Rival fighters ranked here at the opening, as strong as its prestige.
            residents: 15,
            purses: (
                entry_fee: 0,
                win_prize: 50,
                // Paid win or lose: base + per_fame × (fame of both fighters).
                receipts_base: 20,
                receipts_per_fame: 1,
                // Paid for each title defense the club's champion survives.
                champion_bonus: 30,
            ),
        ),
        (
            name: "Rome",
            arena: Pillars,
            prestige: 3,
            residents: 15,
            purses: (
                entry_fee: 20,
                win_prize: 150,
                receipts_base: 40,
                receipts_per_fame: 2,
                champion_bonus: 100,
            ),
        ),
    ],
)
