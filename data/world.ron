// The world's colosseums: placeholder values, to tune while balancing.
(
    // Elo of a fighter's first fight in a colosseum, and how far one fight moves it.
    elo_start: 1000,
    elo_k: 32,
    // Residents' stats grow by this percentage for each prestige level above 1.
    prestige_stats_percent: 10,
    // A champion must defend the title at least once in this many weeks, against a
    // challenger from the first `challengers` of the ranking.
    title_defense_weeks: 4,
    challengers: 5,
    challenges: (
        // Lost by a fighter who refuses a challenge and does not fight that week; the
        // Elo in the challenger's colosseum.
        refusal_fame: 2,
        refusal_elo: 8,
    ),
    // The rival managers' weekly thresholds, by profile. A fighter rests below
    // `rest_form` or when badly hurt or ill, cared for if the club keeps `care_reserve`
    // after paying; fit, it fights when Elo gives it `fight_percent` chances against the
    // others of its colosseum, else trains. Each week, a club's fighter ranked there is
    // challenged by the resident closest in Elo with `challenge_percent` chances; the
    // club accepts the player's challenges when Elo gives it `accept_percent` chances.
    // On the market, it asks `sell_percent` of a fighter's value and offers `buy_percent`
    // for the player's, if it keeps `care_reserve`.
    profiles: (
        cautious: (rest_form: 70, care_reserve: 0, fight_percent: 45, accept_percent: 50, challenge_percent: 10, sell_percent: 150, buy_percent: 60),
        aggressive: (rest_form: 35, care_reserve: 100, fight_percent: 20, accept_percent: 20, challenge_percent: 40, sell_percent: 130, buy_percent: 80),
        // Keeps its money, sells cheap and buys dear.
        merchant: (rest_form: 50, care_reserve: 300, fight_percent: 35, accept_percent: 35, challenge_percent: 20, sell_percent: 100, buy_percent: 90),
    ),
    // The rival clubs, starting with the player's money; the colosseums' residents are
    // shared out among them in turn. At least one.
    rivals: [
        (name: "Ludus Magnus", profile: Cautious),
        (name: "Ludus Gallicus", profile: Aggressive),
        (name: "Ludus Dacicus", profile: Merchant),
    ],
    // At least one must be free to enter: the safety net of a club without money.
    colosseums: [
        (
            name: "Capoue",
            // Effects come with phase 6: sand slows, pillars block shots, narrow favours melee.
            arena: Sand,
            // 1 to 5.
            prestige: 1,
            // Its fighters, all from rival clubs.
            residents: 15,
            purses: (
                entry_fee: 0,
                win_prize: 50,
                // Paid win or lose: base + per_fame × (fame of both fighters).
                receipts_base: 20,
                receipts_per_fame: 1,
                // Paid for each title defense the club's champion survives.
                champion_bonus: 30,
            ),
        ),
        (
            name: "Rome",
            arena: Pillars,
            prestige: 3,
            residents: 15,
            purses: (
                entry_fee: 20,
                win_prize: 150,
                receipts_base: 40,
                receipts_per_fame: 2,
                champion_bonus: 100,
            ),
        ),
    ],
)
