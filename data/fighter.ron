// Rules of the fighter's physical state: placeholder values, to tune while balancing.
(
    form: (
        // k of the risk formula: injury and illness risk is tripled at form 0 with k = 2.
        risk_factor: 2.0,
        // Form lost per fight, per title defense and per week of training,
        // and recovered per week of rest (form goes from 0 to 100).
        fight: 20,
        title_defense: 30,
        training: 5,
        rest: 15,
    ),
    injury: (
        // Chance of an injury per fight at form 100, raised by the risk formula.
        chance_per_fight: 0.15,
        // Relative chances; the side of an arm or leg is drawn 50/50.
        location_weights: (head: 1, body: 3, arm: 3, leg: 3),
        severity_weights: (light: 60, medium: 25, severe: 12, permanent: 3),
        // Lowest and highest weeks to heal without care.
        healing_weeks: (light: (1, 2), medium: (3, 5), severe: (6, 8)),
        // Temporary maluses, as a percentage of `temporary` (written for a medium injury).
        severity_percent: (light: 50, medium: 100, severe: 200),
        // Percentage of each stat lost, by location; missing stats are 0.
        // Head: the plan's precision malus, on both attacks until combat has accuracy.
        temporary: (
            head: (melee_attack: 5, ranged_attack: 5),
            body: (hp: 10, melee_defense: 10),
            dominant_arm: (melee_attack: 15, ranged_attack: 15),
            off_arm: (melee_defense: 15),
            leg: (speed: 15),
        ),
        // After-effects: precision, lost HP, lost arm (dominant or shield), limp.
        permanent: (
            head: (melee_attack: 10, ranged_attack: 10),
            body: (hp: 15),
            dominant_arm: (melee_attack: 50, ranged_attack: 50),
            off_arm: (melee_defense: 40),
            leg: (speed: 25),
        ),
        // Highest percentage of a stat all injuries together can take off.
        max_malus: 80,
    ),
    illness: (
        // Chance of falling ill per week at form 100, raised by the risk formula.
        chance_per_week: 0.05,
        // Relative chances of each level.
        level_weights: (mild: 70, moderate: 25, severe: 5),
        // Lowest and highest weeks to heal without care (at least 1).
        weeks: (mild: (1, 2), moderate: (3, 5), severe: (6, 8)),
        // Percentage taken off every stat.
        malus: (mild: 5, moderate: 15, severe: 30),
        // Percentage of the usual form gain a week of rest gives.
        rest_percent: (mild: 100, moderate: 50, severe: 25),
        // Fighting with a severe illness may make it last longer.
        worsening_chance: 0.5,
        worsening_weeks: (2, 4),
    ),
    care: (
        // Price of care, decided by the player (money comes in phase 4).
        // Permanent injuries can't be cared for.
        injury_cost: (light: 20, medium: 60, severe: 150),
        illness_cost: (mild: 15, moderate: 50, severe: 120),
        // Care keeps this percentage of the weeks left, rounded up, at least 1.
        weeks_kept_percent: 50,
    ),
    personality: (
        // Surrender threshold, as a percentage of max HP, from determination 0 to 100:
        // a fearful fighter gives up early, a fully determined one fights to the death.
        surrender_percent_least_determined: 50,
        surrender_percent_most_determined: 0,
    ),
    morale: (
        // Morale goes from 0 to 100, neutral at 50.
        victory: 10,
        defeat: 10,
        injury: 8,
        illness: 5,
        // Morale gained per fame point gained, in percent.
        fame_percent: 50,
        // Bonus on every stat at morale 100, malus at 0, in percent.
        combat_percent: 5,
    ),
    fame: (
        // Fame goes from 0 to 100.
        victory: 5,
        victory_against_stronger: 5,
        spectacular_hit: 1,
        // A hit is spectacular from this percentage of the target's max HP.
        spectacular_hit_percent: 30,
        surrender: 8,
        // A fight stopped by the time limit, for every fighter in it.
        dull_fight: 3,
    ),
    progression: (
        // No levels: each stat may improve after every training session and fight.
        // Chance in percent, at ages 20 to 27 and neutral morale.
        training_chance: 30,
        fight_chance: 20,
        // Points gained when a stat improves.
        gain: (hp: 2, melee_attack: 1, ranged_attack: 1, speed: 1, melee_defense: 1, ranged_defense: 1),
        // (last age, percent of the chance): fast to 27, plateau to 35, very low to 39, none after.
        age_brackets: [(27, 100), (35, 40), (39, 10)],
        // Chance bonus at morale 100, malus at 0, in percent of the chance.
        morale_percent: 20,
        // A generated hidden potential sits 20 to 80 % above each stat.
        potential_headroom_percent: (20, 80),
        // From 40, stats lose these percentages every year, speed most.
        decline_from_age: 40,
        decline_percent: (hp: 2, melee_attack: 2, ranged_attack: 2, speed: 5, melee_defense: 2, ranged_defense: 2),
    ),
    retirement: (
        // Checked once a year; decided by the fighter only.
        from_age: 30,
        // Percent per year from 30 (counting it) and per permanent injury.
        per_year: 5,
        per_permanent_injury: 15,
        // Determination 0 raises the chance by this percentage of it, 100 lowers it as much.
        determination_percent: 50,
    ),
    career: (
        // Generated fighters: age, stats within this percentage of the standard
        // duel's, chance of being right-handed.
        start_age: (20, 30),
        stats_spread_percent: 20,
        right_handed_percent: 85,
    ),
)
