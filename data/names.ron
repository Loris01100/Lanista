// The world's cultures, from data/world.ron's `clubs.cultures`: the continent its
// clubs are at home on, the names a club of that culture may take, and the patterns
// it is named by. A culture's shown name is `culture-<key>` in the language files
// (assets/lang), a pattern's `club-<pattern>`, which puts the drawn name in place
// of `$name`.
[
    (
        key: "rome",
        continent: Europe,
        names: [
            "Magnus", "Gallicus", "Dacicus", "Matutinus", "Maximus", "Flavius", "Aurelius",
            "Varro", "Crassus", "Scaurus", "Tullius", "Cornelius", "Septimius", "Valerius",
            "Claudius", "Fabius", "Marcellus", "Lucullus", "Capito", "Gracchus",
        ],
        clubs: ["ludus", "familia", "domus"],
    ),
    (
        key: "grece",
