        clubs: ["Maison de l'Aigle de {name}", "Maison du Jaguar de {name}", "Calmecac de {name}"],
    ),
    (
        key: "amerique_sud",
        name: "Tribus d'Amérique du Sud",
        names: [
            "Pachacutec", "Túpac", "Atahualpa", "Manco", "Rumiñahui", "Lautaro",
            "Caupolicán", "Galvarino", "Pelantaro", "Sepé", "Cunhambebe", "Arariboia",
