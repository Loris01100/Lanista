    (
        key: "oceanie",
        name: "Tribus d'Océanie",
        names: [
            "Hongi Hika", "Te Rauparaha", "Kamehameha", "Hōne Heke", "Kiwa", "Tāwhaki",
            "Māui", "Rata", "Tangaroa", "Malietoa", "Kahekili", "Hinemoa",
