// Prices: placeholder values, to tune while balancing.
(
    starting_money: 500,
    // Most fighters in activity a club may have; the dead and retired leave a place.
    max_fighters: 3,
    // Each week, for each active fighter, even into debt.
    upkeep: 10,
    // Each training session.
    training_cost: 5,
    market: (
        // Free agents, signed for nothing: missing ones arrive at the end of the week,
        // the least valuable leave beyond the most.
        min_free_agents: 6,
        max_free_agents: 20,
        // Arriving at the start of each off-season.
        rookies: 8,
        rookie_age: 20,
        // Value: price_per_point per point of trained stats, less age_discount_percent
        // per year above prime_age, down to a tenth. The rival clubs ask and offer a
        // percentage of it (data/world.ron).
        price_per_point: 2,
        prime_age: 30,
        age_discount_percent: 10,
        // The rival clubs release their fighters this old at the start of each off-season.
        release_age: 33,
        // Stats of fighters out of the club are seen within a range this wide, in
        // percent of the stat; narrower after a week of observation.
        range_percent: 40,
        observed_range_percent: 20,
    ),
    // Colosseum purses are in data/world.ron.
)
