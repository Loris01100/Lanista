// Prices: placeholder values, to tune while balancing.
(
    // A club's wealth: its money at the start of a game, and from how much money at the start of an off-season it rises to that level
    // (one level a season; it falls back below half of its level's).
    wealth: (
        poor: (starting_money: 300, from: 0),
        modest: (starting_money: 800, from: 5000),
        rich: (starting_money: 10000, from: 12000),
    ),
    // Most fighters in activity a club may have; the dead and retired leave a place.
    max_fighters: 3,
    // Each week, for each active fighter, even into debt.
    upkeep: 10,
    // Each training session without a trainer.
    training_cost: 5,
    staff: (
        // Every salary is paid every week, even into debt, once for every so many
        // fighters in activity, at least once: a larger club gives its staff more work.
        fighters_per_salary: 3,
        // Trainer levels 1 to 5: salary; price of a training session; chance added to
        // each stat's chance to improve at a session, in percent of it; form a session
        // costs less (5 without a trainer, data/fighter.ron).
        trainers: [
            (salary: 10, training_cost: 5, coaching: (progress_percent: 10, form_spared: 1)),
            (salary: 20, training_cost: 6, coaching: (progress_percent: 20, form_spared: 1)),
            (salary: 35, training_cost: 7, coaching: (progress_percent: 35, form_spared: 2)),
            (salary: 55, training_cost: 8, coaching: (progress_percent: 50, form_spared: 3)),
            (salary: 80, training_cost: 10, coaching: (progress_percent: 75, form_spared: 4)),
        ],
        // Doctor levels 1 to 5: salary; percentage points taken off the weeks left care
        // keeps (50 without a doctor, data/fighter.ron); price of care in percent of the
        // usual price; chance in percent that an injury that would leave an after-effect
        // is only severe. No doctor heals a permanent injury already there.
        doctors: [
            (salary: 10, medicine: (care_weeks_off_percent: 5, care_cost_percent: 100, after_effect_spared_percent: 15)),
            (salary: 20, medicine: (care_weeks_off_percent: 10, care_cost_percent: 110, after_effect_spared_percent: 30)),
            (salary: 35, medicine: (care_weeks_off_percent: 15, care_cost_percent: 120, after_effect_spared_percent: 45)),
            (salary: 55, medicine: (care_weeks_off_percent: 20, care_cost_percent: 130, after_effect_spared_percent: 60)),
            (salary: 80, medicine: (care_weeks_off_percent: 30, care_cost_percent: 150, after_effect_spared_percent: 75)),
        ],
        // Recruiter levels 1 to 5: salary; stats revealed each week of observation on
        // top of the market's; width of the stat ranges in percent of the usual one;
        // width of the estimate of the potential in percent of it, once observed (0: no
        // estimate); whether an observed fighter's personality, then its ease with each
        // loadout, is seen.
        recruiters: [
            (salary: 10, scouting: (revealed_per_week: 0, range_width_percent: 90, potential_range_percent: 0, personality: false, ease: false)),
            (salary: 20, scouting: (revealed_per_week: 1, range_width_percent: 80, potential_range_percent: 0, personality: false, ease: false)),
            (salary: 30, scouting: (revealed_per_week: 1, range_width_percent: 70, potential_range_percent: 40, personality: false, ease: true)),
            (salary: 45, scouting: (revealed_per_week: 2, range_width_percent: 60, potential_range_percent: 30, personality: true, ease: true)),
            (salary: 65, scouting: (revealed_per_week: 2, range_width_percent: 50, potential_range_percent: 20, personality: true, ease: true)),
        ],
        // The candidates on the market, for the player and the rival clubs alike: so
        // many for each post at the start of a week, missing ones arriving at the end
        // of the week; each stays between min_weeks and max_weeks unless hired. A new
        // candidate's level is drawn by these weights, from level 1; each of its stats
        // and its salary is its level's, give or take up to spread_percent.
        market: (
            candidates: 3,
            min_weeks: 2,
            max_weeks: 6,
            level_weights: [30, 25, 20, 15, 10],
            spread_percent: 20,
        ),
    ),
    market: (
        // Free agents, signed for nothing: missing ones arrive at the end of the week,
        // the least valuable leave beyond the most.
        min_free_agents: 20,
        max_free_agents: 60,
        // Arriving at the start of each off-season.
        rookies: 16,
        rookie_age: 20,
        // Value: so much per point of trained stats and of fame, per fight won and
        // drawn, less per fight lost; never below a tenth of the stats' part. The rival
        // clubs ask and offer a percentage of it (data/world.ron).
        price_per_point: 2,
        price_per_fame: 5,
        price_per_win: 15,
        price_per_draw: 5,
        price_per_loss: 10,
        // At the start of each off-season, a rival club releases its fighters this old
        // worth less than its average fighter.
        release_age: 30,
        // A rich club also lets go, at any age, those worth less than this percentage
        // of its average fighter; and each week it tries to buy a fighter of another
        // club worth at least this percentage of its weakest, letting its weakest go
        // when that takes it past its most (data/world.ron).
        rich_release_percent: 75,
        rich_upgrade_percent: 125,
        // A club counters an offer of at least this percentage of its asking price,
        // and refuses a lower one.
        counter_percent: 75,
        // A fighter's chance of refusing to join, plus half its fame above the club's
        // best, plus a fifth of its caution above 50.
        refusal_percent: 20,
        // Each week, the chance a rival club offers unasked for one of the player's
        // fighters neither listed nor kept: so much, plus a point per so much of its
        // value, at most so much.
        unsolicited_percent: 2,
        unsolicited_value: 200,
        unsolicited_max_percent: 20,
        // Stats of fighters out of the club: so many seen at first, so many more each
        // week of observation, then a further week narrows their ranges (in percent of
        // the stat).
        shown_stats: 2,
        revealed_per_week: 2,
        range_percent: 40,
        narrowed_range_percent: 20,
    ),
    // Colosseum purses are in data/world.ron.
)
