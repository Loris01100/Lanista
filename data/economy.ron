// Prices: placeholder values, to tune while balancing.
(
    starting_money: 500,
    // Most fighters in activity a club may have; the dead and retired leave a place.
    max_fighters: 3,
    // Each week, for each active fighter, even into debt.
    upkeep: 10,
    // Each training session without a trainer.
    training_cost: 5,
    staff: (
        // Trainer levels 1 to 5: salary paid every week, even into debt; price of a
        // training session; chance added to each stat's chance to improve at a session,
        // in percent of it; form a session costs less (5 without a trainer,
        // data/fighter.ron).
        trainers: [
            (salary: 10, training_cost: 5, coaching: (progress_percent: 10, form_spared: 1)),
            (salary: 20, training_cost: 6, coaching: (progress_percent: 20, form_spared: 1)),
            (salary: 35, training_cost: 7, coaching: (progress_percent: 35, form_spared: 2)),
            (salary: 55, training_cost: 8, coaching: (progress_percent: 50, form_spared: 3)),
            (salary: 80, training_cost: 10, coaching: (progress_percent: 75, form_spared: 4)),
        ],
    ),
    market: (
        // Free agents, signed for nothing: missing ones arrive at the end of the week,
        // the least valuable leave beyond the most.
        min_free_agents: 6,
        max_free_agents: 20,
        // Arriving at the start of each off-season.
        rookies: 8,
        rookie_age: 20,
        // Value: so much per point of trained stats and of fame, per fight won and
        // drawn, less per fight lost; never below a tenth of the stats' part. The rival
        // clubs ask and offer a percentage of it (data/world.ron).
        price_per_point: 2,
        price_per_fame: 5,
        price_per_win: 15,
        price_per_draw: 5,
        price_per_loss: 10,
        // At the start of each off-season, a rival club releases its fighters this old
        // worth less than its average fighter.
        release_age: 33,
        // A club counters an offer of at least this percentage of its asking price,
        // and refuses a lower one.
        counter_percent: 75,
        // A fighter's chance of refusing to join, plus half its fame above the club's
        // best, plus a fifth of its caution above 50.
        refusal_percent: 20,
        // Stats of fighters out of the club: so many seen at first, so many more each
        // week of observation, then a further week narrows their ranges (in percent of
        // the stat).
        shown_stats: 2,
        revealed_per_week: 2,
        range_percent: 40,
        narrowed_range_percent: 20,
    ),
    // Colosseum purses are in data/world.ron.
)
